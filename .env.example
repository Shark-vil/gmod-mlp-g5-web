# copy to .env and edit — everything is optional
# admins: SteamID64s (comma separated) — after "Войти через Steam" they get /api/docs and the admin API / pages
MLP_ADMIN_STEAMIDS=
# the site's public address (for the Steam login's return link); empty = taken from the request
MLP_PUBLIC_URL=https://manetown.itpony.pro
# secret for the login cookies; empty = made once and kept in the database
MLP_SESSION_SECRET=
# optional old-style admin token for scripts (X-Admin-Token header on /api/v1/admin/*); empty = off
MLP_ADMIN_TOKEN=
# optional trusted servers ("name:key,..."): reports with that X-Server-Key are named and skip the per-IP install limit
MLP_SERVER_KEYS=
# per install (= one game server, however many players): reports / unlock lookups per minute
MLP_RATE_PER_MIN=30
MLP_LOOKUP_PER_MIN=60
# per IP (a big server, a hoster with many servers, players behind NAT share one): flood guard / new installs a day
MLP_IP_RATE_PER_MIN=300
MLP_NEW_INSTALLS_PER_IP_DAY=20
# player songs for the dance (upload limits): file size, length in seconds, drafts per player, uploads per hour
MLP_SONG_MAX_MB=40
MLP_SONG_MAX_SEC=300
MLP_SONG_MAX_DRAFTS=5
MLP_SONG_UPLOADS_PER_HOUR=10
# host port
MLP_PORT=8080
