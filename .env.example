# copy to .env and edit
# game servers allowed to report: name:key pairs, comma separated (the key goes to the GMod server's mlp_api_key)
MLP_SERVER_KEYS=my-server:change-me-to-a-long-random-string
# 1 = accept any non-empty key (local testing only)
MLP_OPEN=0
# reports per key per minute
MLP_RATE_PER_MIN=30
# host port
MLP_PORT=8080
